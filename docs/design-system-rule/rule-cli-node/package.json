{
  "name": "rule-cli",
  "version": "0.1.0",
  "description": "The Rule terminal design system (ds-next, Modernist direction) as a reference CLI in TypeScript + Ink: the whole spec as source, a tour of every part, and a live session.",
  "type": "module",
  "bin": {
    "rule": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "ink": "6.8.0",
    "react": "19.2.8",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
