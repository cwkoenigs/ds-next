{
  "name": "rule-cli",
  "version": "0.1.0",
  "description": "The Rule terminal design system (ds-next, Modernist direction) as a reference CLI in TypeScript + Ink: the whole spec as source, a tour of every part, and a live session.",
  "type": "module",
  "bin": {
    "rule": "dist/cli.js"
  },
  "files": [
    "dist",
    "python"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@snowflake/cortex-agent-sdk": "0.0.3",
    "chalk": "6.0.1",
    "ink": "8.0.0",
    "react": "19.3.1",
    "smol-toml": "1.9.1",
    "string-width": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
