{
  "name": "Rule",
  "product": "ds-next",
  "version": "1.0.0-modernist",
  "date": "2026-10-24",
  "source": "Modernist design system (fb669593) — neutral + accent ramps, 2px rules, radius 0, flush-left labels",
  "relation": "independent; same hybrid shape as Canopy (pinned footing), Modernist grammar",
  "color": {
    "roles": ["bg", "surface", "text", "muted", "dim", "rule", "accent", "accentText"],
    "dark":  { "bg": "#201e1d", "surface": "#2d2b2b", "text": "#f3f2f2", "muted": "#bab6b6", "dim": "#7d7979", "rule": "#9b9797", "accent": "#ff563c", "accentText": "#ff9783" },
    "light": { "bg": "#f3f2f2", "surface": "#eae9e9", "text": "#201e1d", "muted": "#605d5d", "dim": "#9b9797", "rule": "#605d5d", "accent": "#ec3013", "accentText": "#ae1800" },
    "modernist": { "dark": { "bg": "text", "surface": "neutral-900", "text": "bg", "muted": "neutral-400", "dim": "neutral-600", "rule": "neutral-500", "accent": "accent-500", "accentText": "accent-400" },
                   "light": { "bg": "bg", "surface": "surface", "text": "text", "muted": "neutral-700", "dim": "neutral-500", "rule": "neutral-700", "accent": "accent", "accentText": "accent-700" } },
    "ansi16": { "text": "default", "muted": "bright_black", "dim": "bright_black", "rule": "bright_black", "accent": "red", "accentText": "bold red", "surface": "on bright_black" },
    "rules": [
      "one colour: red means needs-you — prompt, agent square, focused option, warning, failure",
      "done is text; there is no green",
      "tool args and facts muted; results, thinking, hints, status row dim",
      "rules and frames in rule; a frame goes accent while asking",
      "a failed result's first line is accentText"
    ]
  },
  "glyphs": {
    "prompt": "›", "agent": "■", "tool": "▪", "pending": "▫", "option": "□", "result": "└", "think": "·",
    "ok": "✓", "warn": "⚠", "err": "✗", "choice": ["‹", "›"],
    "frame": { "tl": "┏", "tr": "┓", "bl": "┗", "br": "┛", "h": "━", "v": "┃", "tee": ["┳", "┻"] },
    "spinner": { "name": "quadrant", "frames": ["▖", "▘", "▝", "▗"], "intervalMs": 160 },
    "retired": ["⏺ ⎿ ✻ (Canopy)", "● → │ ╰ ◐ (Rail)", "rounded corners", "light box lines", "any colour but red"]
  },
  "spinnerVerbs": ["Drafting", "Ruling", "Measuring", "Squaring", "Aligning", "Plotting", "Setting", "Composing", "Inking", "Paddling", "Portaging", "Sounding", "Charting"],
  "grid": {
    "designWidth": 80, "minWidth": 60,
    "indent": 2, "resultIndent": 4, "labelWidth": 12, "factSeparator": "  ",
    "columns": { "glyph": 1, "text": 3, "resultGlyph": 3, "resultText": 5, "formValue": 16 },
    "turnRule": "━━ NN ━━━… full width before every prompt",
    "footing": { "rows": 4, "order": ["box top", "input line(s)", "box bottom", "status row"], "popupBetween": ["box bottom", "status row"] },
    "rhythm": "rule before every prompt; one blank after; one between messages; none between tool and └; one above a frame"
  },
  "type": { "mono": ["JetBrains Mono", "SF Mono", "Menlo", "Cascadia Code", "DejaVu Sans Mono"], "doc": ["Archivo"], "case": "frame titles, banner word-mark and form labels uppercase; flow lowercase; no italics" },
  "motion": {
    "redrawRegion": "footing only",
    "liveLine": "▘ {verb}  {secs}s  esc interrupts — above the footing, replaced in place",
    "thinking": "dim with · lead; folds to '· Thought for Ns  ctrl-o'",
    "fold": "└ N more lines  ctrl-o at col 5",
    "dialog": "replaces the box, accent edge, uppercase title, ■/□ options, esc = last"
  },
  "mascot": { "name": "canoe with paddle", "size": [28, 20], "inks": { "I": "text", "R": "accent" }, "file": "assets/mascot.txt" }
}
